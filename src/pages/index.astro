---
import ArrowRight from "@/assets/icons/arrow-right.svg"
import MetaPage from "@/components/MetaPage.astro"
import SocialIcons from "@/components/SocialIcons.astro"
import Layout from "@/layouts/Layout.astro"
import { SOCIALS } from "@/consts"
import { getPosts } from "@/lib/content"
import { formatDate } from "@/lib/utils"
import { Image } from "astro:assets"
import { getCollection } from "astro:content"

const [author] = await getCollection("authors")
const posts = (await getPosts()).slice(0, 4)
const projects = (await getCollection("projects")).sort(
  (a, b) =>
    (b.data.startDate?.getTime() ?? 0) - (a.data.startDate?.getTime() ?? 0),
)
const featured = projects[0]
---

<Layout wide>
  <MetaPage slot="head" />

  <div class="home">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-main">
        <p class="eyebrow"><span class="dot"></span>Offensive security · CTF</p>
        <h1 id="hero-title">Hi, I'm <span class="accent">chjwoo</span>.</h1>
        <p class="lede">
          Student from Indonesia exploring offensive security, penetration
          testing, and CTF. I break systems on purpose, then write down exactly
          how.
        </p>
        <div class="hero-actions">
          <a class="btn primary" href="/blog">Read the blog <ArrowRight /></a>
          <a class="btn ghost" href="/about">About me</a>
        </div>
      </div>

      {author && (
        <aside class="profile-card">
          <div class="profile-head">
            <img
              class="avatar"
              src={author.data.avatar}
              alt=""
              width="56"
              height="56"
            />
            <div class="profile-id">
              <p class="profile-name">
                {author.data.name}
                {author.data.pronouns && (
                  <span class="pronouns">{author.data.pronouns}</span>
                )}
              </p>
              <p class="profile-bio">{author.data.bio}</p>
            </div>
          </div>
          <SocialIcons links={SOCIALS} />
        </aside>
      )}
    </section>

    <section class="section" aria-labelledby="writing-title">
      <header class="section-head">
        <h2 id="writing-title">Latest writing</h2>
        <a class="section-link" href="/blog">All posts <ArrowRight /></a>
      </header>

      {posts.length > 0 ? (
        <ol class="post-index">
          {posts.map((post, i) => (
            <li>
              <a href={`/blog/${post.id}`}>
                <span class="idx" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span class="post-title">{post.data.title}</span>
                <time datetime={post.data.date.toISOString()}>
                  {formatDate(post.data.date)}
                </time>
                <ArrowRight />
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <p class="empty">No posts published yet. The first write-up is coming.</p>
      )}
    </section>

    <section class="section" aria-labelledby="projects-title">
      <header class="section-head">
        <h2 id="projects-title">Projects</h2>
        <a class="section-link" href="/projects">All projects <ArrowRight /></a>
      </header>

      {featured ? (
        <a class="featured" href={`/projects/${featured.id}`}>
          {featured.data.image && (
            <div class="featured-media">
              <Image
                src={featured.data.image}
                alt=""
                width={960}
                height={540}
              />
            </div>
          )}
          <div class="featured-body">
            <p class="eyebrow">Featured project</p>
            <h3>{featured.data.name}</h3>
            <p>{featured.data.description}</p>
            {featured.data.tags && featured.data.tags.length > 0 && (
              <div class="featured-tags">
                {featured.data.tags.map((tag) => <span>{tag}</span>)}
              </div>
            )}
            <span class="featured-cta">View project <ArrowRight /></span>
          </div>
        </a>
      ) : (
        <p class="empty">No projects yet.</p>
      )}
    </section>
  </div>
</Layout>

<style>
  .home {
    --accent: light-dark(#5b5de3, #9b9cff);

    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem;
    align-items: start;
    gap: var(--space-l);
    padding-block-end: var(--space-l);
    border-block-end: 1px solid var(--border);

    @media (width < 64rem) {
      grid-template-columns: 1fr;
    }
  }

  .hero-main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55ch;
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  .dot {
    inline-size: 0.4rem;
    block-size: 0.4rem;
    border-radius: var(--radius-full);
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent) 18%, transparent);
  }

  h1 {
    max-inline-size: 16ch;
    margin-block-start: var(--space-xs);
    font-size: var(--step-3);
    font-weight: 700;
    line-height: calc(var(--leading-offset) + 0.85em);
    letter-spacing: -0.02em;
    text-wrap: balance;
    color: var(--foreground);

    .accent {
      color: var(--accent);
    }
  }

  .lede {
    max-inline-size: 54ch;
    margin-block-start: var(--space-2xs);
    font-size: var(--step-1);
    line-height: calc(var(--leading-offset) + 1.1em);
    color: var(--prose-foreground);
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: var(--space-m);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.5rem 0.95rem;
    border-radius: var(--radius-full);
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      opacity 0.2s ease,
      transform 0.2s ease;

    svg {
      inline-size: 0.95em;
      block-size: 0.95em;
    }

    &:active {
      transform: translateY(1px);
    }
  }

  .btn.primary {
    border: 1px solid var(--foreground);
    background: var(--foreground);
    color: var(--background);

    &:hover {
      opacity: 0.88;
    }
  }

  .btn.ghost {
    border: 1px solid var(--border);
    color: var(--foreground);

    &:hover {
      background: color-mix(in oklab, var(--muted) 60%, transparent);
      border-color: var(--ring);
    }
  }

  .profile-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: var(--space-m);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: color-mix(in oklab, var(--muted) 40%, transparent);
  }

  .profile-head {
    display: flex;
    align-items: center;
    gap: var(--space-s);
  }

  .avatar {
    inline-size: 3.5rem;
    block-size: 3.5rem;
    border-radius: var(--radius-full);
    object-fit: cover;
    border: 1px solid var(--border);
  }

  .profile-name {
    font-size: var(--step-0);
    font-weight: var(--font-weight-medium);
    color: var(--foreground);
  }

  .pronouns {
    margin-inline-start: 0.35ch;
    font-size: var(--step--1);
    font-weight: 400;
    color: var(--muted-foreground);
  }

  .profile-bio {
    font-size: var(--step--1);
    color: var(--muted-foreground);
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs);

    h2 {
      font-size: var(--step-1);
      font-weight: var(--font-weight-medium);
      color: var(--foreground);
    }
  }

  .section-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-size: var(--step--1);
    color: var(--muted-foreground);
    text-decoration: none;

    svg {
      inline-size: 0.9em;
      block-size: 0.9em;
      transition: transform 0.2s ease;
    }

    &:hover {
      color: var(--foreground);

      svg {
        transform: translateX(2px);
      }
    }
  }

  .post-index {
    display: flex;
    flex-direction: column;
    list-style: none;

    li + li {
      border-block-start: 1px solid var(--border);
    }

    a {
      display: grid;
      grid-template-columns: 2.25rem minmax(0, 1fr) auto 1.25rem;
      align-items: center;
      gap: var(--space-s);
      padding: var(--space-s) var(--space-2xs);
      border-radius: var(--radius-md);
      color: inherit;
      text-decoration: none;
      transition: background-color 0.2s ease;

      &:hover {
        background: color-mix(in oklab, var(--muted) 60%, transparent);

        > svg {
          color: var(--foreground);
          transform: translateX(2px);
        }
      }

      > svg {
        inline-size: 1rem;
        block-size: 1rem;
        color: var(--muted-foreground);
        transition:
          color 0.2s ease,
          transform 0.2s ease;
      }
    }

    .idx {
      font-family: var(--font-mono);
      font-size: var(--step--1);
      color: color-mix(in oklab, var(--muted-foreground) 55%, transparent);
    }

    .post-title {
      display: -webkit-box;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      line-clamp: 2;
      font-size: var(--step-0);
      font-weight: var(--font-weight-medium);
      line-height: calc(var(--leading-offset) + 0.6em);
      color: var(--foreground);
    }

    time {
      font-size: var(--step--1);
      color: var(--muted-foreground);
      white-space: nowrap;
    }

    @media (width < 40rem) {
      a {
        grid-template-columns: 1.75rem minmax(0, 1fr) 1rem;
      }

      time {
        display: none;
      }
    }
  }

  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    align-items: center;
    gap: var(--space-m);
    padding: var(--space-m);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;

    &:hover {
      border-color: var(--ring);
      background: color-mix(in oklab, var(--muted) 35%, transparent);

      .featured-cta svg {
        transform: translateX(2px);
      }
    }

    @media (width < 56rem) {
      grid-template-columns: 1fr;
    }
  }

  .featured-media img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .featured-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2xs);

    h3 {
      margin-block-start: var(--space-3xs);
      font-size: var(--step-2);
      font-weight: 700;
      line-height: calc(var(--leading-offset) + 0.8em);
      letter-spacing: -0.01em;
      text-wrap: balance;
      color: var(--foreground);
    }

    > p {
      color: var(--muted-foreground);
    }
  }

  .featured-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    margin-block-start: var(--space-3xs);

    span {
      padding: 0.1rem 0.5rem;
      border: 1px solid var(--border);
      border-radius: var(--radius-full);
      font-size: var(--step--1);
      color: var(--muted-foreground);
    }
  }

  .featured-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    margin-block-start: var(--space-2xs);
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    color: var(--foreground);

    svg {
      inline-size: 0.9em;
      block-size: 0.9em;
      transition: transform 0.2s ease;
    }
  }

  .empty {
    font-size: var(--step--1);
    color: var(--muted-foreground);
  }
</style>
