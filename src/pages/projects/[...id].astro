---
import ExternalIcon from "@/assets/icons/external.svg"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { formatDate } from "@/lib/utils"
import { Image } from "astro:assets"
import { getCollection, render } from "astro:content"

export async function getStaticPaths() {
  const projects = await getCollection("projects")
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }))
}

const { project } = Astro.props
const { Content } = await render(project)
const { name, description, link, tags, image, startDate, endDate } = project.data
---

<Layout
  wide
  crumbs={[{ label: name, href: `/projects/${project.id}` }]}
>
  <MetaPage slot="head" title={name} description={description} />

  <article class="project-detail">
    {image && (
      <div class="project-cover">
        <Image src={image} alt="" width={1600} height={900} priority />
      </div>
    )}

    <header class="project-header">
      <h1>{name}</h1>
      <p class="project-desc">{description}</p>

      <div class="project-meta">
        {startDate && (
          <div class="project-dates">
            <time datetime={startDate.toISOString()}>
              {formatDate(startDate)}
            </time>
            <span aria-hidden="true">→</span>
            {endDate ? (
              <time datetime={endDate.toISOString()}>
                {formatDate(endDate)}
              </time>
            ) : (
              <span>Present</span>
            )}
          </div>
        )}

        {tags && tags.length > 0 && (
          <div class="project-tags">
            {tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        )}

        <a
          href={link}
          target="_blank"
          rel="noopener noreferrer"
          class="external-btn"
        >
          <span>Visit project</span>
          <ExternalIcon aria-hidden="true" />
        </a>
      </div>
    </header>

    <section class="project-body">
      <prose-content><Content /></prose-content>
    </section>
  </article>
</Layout>

<style>
  .project-detail {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
  }

  .project-cover {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background: var(--muted);
  }

  .project-cover img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 16 / 8;
    object-fit: cover;
  }

  .project-header {
    display: flex;
    flex-direction: column;
    max-inline-size: 44rem;

    h1 {
      font-size: var(--step-3);
      line-height: calc(var(--leading-offset) + 0.9em);
      font-weight: 700;
      letter-spacing: -0.015em;
      text-wrap: balance;
      color: var(--foreground);
    }
  }

  .project-desc {
    margin-block-start: var(--space-2xs);
    font-size: var(--step-1);
    line-height: calc(var(--leading-offset) + 1.1em);
    color: var(--prose-foreground);
    text-wrap: pretty;
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-s);
    margin-block-start: var(--space-s);
    padding-block-start: var(--space-s);
    border-block-start: 1px solid var(--border);
    font-size: var(--step--1);
    color: var(--muted-foreground);
  }

  .project-dates {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);

    .tag {
      padding: 0.15rem 0.55rem;
      border: 1px solid var(--border);
      border-radius: var(--radius-full);
      background: color-mix(in oklab, var(--muted) 60%, transparent);
      color: var(--muted-foreground);
    }
  }

  .external-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-inline-start: auto;
    padding: 0.35rem 0.8rem;
    border: 1px solid transparent;
    border-radius: var(--radius-full);
    background: var(--foreground);
    color: var(--background);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;

    &:hover {
      opacity: 0.88;
    }

    &:active {
      transform: translateY(1px);
    }

    svg {
      inline-size: 0.85em;
      block-size: 0.85em;
    }
  }

  .project-body {
    padding-block-start: var(--space-m);
    border-block-start: 1px solid var(--border);
  }

  .project-body :global(img) {
    display: block;
    max-inline-size: 100%;
    block-size: auto;
    margin-inline: auto;
    border-radius: var(--radius-lg);
  }

  .project-body :global(p > img:only-child) {
    max-inline-size: min(100%, 22rem);
  }

  @media (width < 48rem) {
    .external-btn {
      margin-inline-start: 0;
    }
  }
</style>
